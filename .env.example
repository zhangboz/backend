# Copy non-secret local settings into .env.local. Keep secrets in .env.
HOST=127.0.0.1
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
DB_HOST=127.0.0.1
DB_PORT=3001
DB_NAME=homeworkhelpai
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=
SESSION_SECRET=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# stripe listen supplies a different signing secret from the former Render URL.
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_USER=
MAIL_PASS=
AI_MAX_CONCURRENT=2
AI_REQUESTS_PER_MINUTE=5

# Production behind the Render proxy uses TRUST_PROXY_HOPS=1.
TRUST_PROXY_HOPS=0

# Neon deployment uses a pooled URL with TLS; leave blank for local DB_* settings.
DATABASE_URL=
DB_SSL=false
# Local SMTP remains optional. Render production uses EMAIL_PROVIDER=resend.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
MAIL_FROM=
EMAIL_TIMEOUT_MS=10000
# Optional separate secret; otherwise JWT_SECRET signs export URLs.
EXPORT_SIGNING_SECRET=
STRIPE_TEST_MODE=true
# Keep separate identities for separate databases; Render uses synapse-render.
STRIPE_DEPLOYMENT_ID=local
